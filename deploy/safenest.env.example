# Configuration du boîtier SafeNest, lue par le service systemd.
# Copiée par deploy/install_service.sh dans ~/.config/safenest/env (à modifier là-bas).

# Adresse de l'API SafeNest (préfixe /v1 inclus)
SAFENEST_API_URL=http://localhost:3333/v1

# Port de l'interface locale (80 = http://safenest.local sans numéro de port)
PORT=80

# Source vidéo utilisée tant qu'aucune caméra n'est configurée dans la web app
SAFENEST_VIDEO_URL=

# Délai minimal entre deux alertes du même type, en secondes
SAFENEST_ALERT_COOLDOWN=120

# Durée du clip envoyé avec une alerte, en secondes (cahier des charges : 3 minutes)
SAFENEST_CLIP_SECONDS=180

# Démarrer la surveillance automatiquement (0 pour attendre le bouton « Démarrer »)
SAFENEST_AUTOSTART=1
